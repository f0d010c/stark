<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonance.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Resonance.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <Page.DataContext>
        <vm:SettingsViewModel />
    </Page.DataContext>

    <Grid>
        <ScrollViewer Padding="36,12,36,36" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Title -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                    <TextBlock Text="Resonance · 4.2.0 (1872)"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Profile -->
                <tk:SettingsCard Header="A. Hayes"
                                 Description="Family · 4 members"
                                 IsClickEnabled="True">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>

                <!-- Audio -->
                <TextBlock Text="Audio" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <StackPanel Spacing="2">
                    <tk:SettingsCard Header="Streaming"
                                     Description="Audio quality on Wi-Fi and cellular">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE93C;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox SelectedIndex="{Binding StreamingQualityIndex, Mode=TwoWay}" MinWidth="200">
                            <x:String>High Efficiency · AAC 64 kbps</x:String>
                            <x:String>High Quality · AAC 256 kbps</x:String>
                            <x:String>Lossless · ALAC 24-bit / 48 kHz</x:String>
                            <x:String>Hi-Res Lossless · 24-bit / 192 kHz</x:String>
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Equalizer"
                                     Description="Adjust frequency response">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9E9;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox SelectedIndex="{Binding EqualizerIndex, Mode=TwoWay}" MinWidth="160">
                            <x:String>Flat</x:String>
                            <x:String>Acoustic</x:String>
                            <x:String>Bass Booster</x:String>
                            <x:String>Classical</x:String>
                            <x:String>Electronic</x:String>
                            <x:String>Hip-Hop</x:String>
                            <x:String>Jazz</x:String>
                            <x:String>Pop</x:String>
                            <x:String>Rock</x:String>
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Sound Check"
                                     Description="Normalize loudness across tracks">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE995;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding SoundCheck, Mode=TwoWay}" />
                    </tk:SettingsCard>

                    <tk:SettingsExpander Header="Spatial Audio"
                                         Description="Dolby Atmos and head tracking">
                        <tk:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7F6;" />
                        </tk:SettingsExpander.HeaderIcon>
                        <ComboBox SelectedIndex="{Binding DolbyAtmosIndex, Mode=TwoWay}" MinWidth="160">
                            <x:String>Automatic</x:String>
                            <x:String>Always On</x:String>
                            <x:String>Off</x:String>
                        </ComboBox>
                        <tk:SettingsExpander.Items>
                            <tk:SettingsCard Header="Head Tracking"
                                             Description="Requires compatible headphones">
                                <ToggleSwitch IsOn="{Binding HeadTracking, Mode=TwoWay}" />
                            </tk:SettingsCard>
                        </tk:SettingsExpander.Items>
                    </tk:SettingsExpander>
                </StackPanel>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Lossless requires a wired connection"
                         Message="Lossless and Hi-Res audio require an external DAC over USB. Bluetooth playback is limited to AAC." />

                <!-- Downloads & Data -->
                <TextBlock Text="Downloads &amp; Data" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <StackPanel Spacing="2">
                    <tk:SettingsCard Header="Download Quality"
                                     Description="Quality for offline files">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74B;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ComboBox SelectedIndex="{Binding DownloadQualityIndex, Mode=TwoWay}" MinWidth="160">
                            <x:String>High</x:String>
                            <x:String>Lossless</x:String>
                        </ComboBox>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Cellular Streaming"
                                     Description="Use mobile data when on the go">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE701;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding CellularStreaming, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </StackPanel>

                <!-- Playback -->
                <TextBlock Text="Playback" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <StackPanel Spacing="2">
                    <tk:SettingsCard Header="Crossfade"
                                     Description="Blend the end of one track into the next">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </tk:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider Width="180"
                                    Minimum="0" Maximum="12" StepFrequency="1"
                                    Value="{Binding CrossfadeSeconds, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CrossfadeSeconds}"
                                       VerticalAlignment="Center"
                                       MinWidth="24"
                                       FontFamily="Cascadia Mono" />
                            <TextBlock Text="s"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Animated Album Art"
                                     Description="Subtle motion on the now-playing surface">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </tk:SettingsCard.HeaderIcon>
                        <ToggleSwitch IsOn="{Binding AnimatedArt, Mode=TwoWay}" />
                    </tk:SettingsCard>
                </StackPanel>

                <!-- Lyrics -->
                <TextBlock Text="Lyrics" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <tk:SettingsExpander Header="Translate Lyrics"
                                     Description="Show translation alongside the original"
                                     IsExpanded="{Binding ShowLyricsTranslation, Mode=TwoWay}">
                    <tk:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xF2B7;" />
                    </tk:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{Binding ShowLyricsTranslation, Mode=TwoWay}" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Language">
                            <tk:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xF2B7;" />
                            </tk:SettingsCard.HeaderIcon>
                            <ComboBox SelectedIndex="{Binding LyricsLanguageIndex, Mode=TwoWay}" MinWidth="160">
                                <x:String>English</x:String>
                                <x:String>Español</x:String>
                                <x:String>Français</x:String>
                                <x:String>Deutsch</x:String>
                                <x:String>日本語</x:String>
                            </ComboBox>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <!-- About -->
                <TextBlock Text="About" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                <StackPanel Spacing="2">
                    <tk:SettingsCard Header="Version">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </tk:SettingsCard.HeaderIcon>
                        <TextBlock Text="4.2.0 (1872)"
                                   FontFamily="Cascadia Mono"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Send feedback"
                                     Description="Tell us what works and what doesn't"
                                     IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE715;" />
                        </tk:SettingsCard.HeaderIcon>
                    </tk:SettingsCard>

                    <tk:SettingsCard Header="Sign Out"
                                     IsClickEnabled="True">
                        <tk:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xF3B1;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </tk:SettingsCard.HeaderIcon>
                        <Button Content="Sign Out"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding SignOutCommand}" />
                    </tk:SettingsCard>
                </StackPanel>

                <TextBlock Text="© 2026 Resonance Audio Labs · Made in Berlin"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Margin="0,16,0,40" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
