<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Resonance.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resonance"
    xmlns:controls="using:Resonance.Controls"
    Background="Transparent">

    <Page.Resources>
        <local:SecondsToTimeConverter   x:Key="Time" />
        <local:HexToColorConverter      x:Key="HexColor" />
        <local:HexToBrushConverter      x:Key="HexBrush" />
        <local:PlayPauseGlyphConverter  x:Key="PlayPauseGlyph" />
    </Page.Resources>

    <Grid>
        <!-- ====================================================
             HERO ATMOSPHERE — full-bleed art-derived gradient
             Layered: gradient + glow + grain (approximated)
             This is the branded surface. Mica is still behind.
             ==================================================== -->
        <Grid>
            <!-- Layer 1: bottom-up gradient from accent (WinUI 3 has no OpacityMask; bake fade into stops) -->
            <Rectangle Opacity="0.55">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="0.45" Color="Transparent" />
                        <GradientStop Offset="0.85" Color="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexColor}, Mode=OneWay}" />
                        <GradientStop Offset="1"    Color="{Binding CurrentTrack.ArtGradientToHex,   Converter={StaticResource HexColor}, Mode=OneWay}" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Layer 2: top-right radial glow (light streak) -->
            <Ellipse Width="900" Height="600"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-200,-200,0"
                     Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0"   Color="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexColor}, Mode=OneWay}" />
                        <GradientStop Offset="1"   Color="Transparent" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Layer 3: vignette (darken edges) -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9" GradientOrigin="0.5,0.5">
                        <GradientStop Offset="0.5" Color="Transparent" />
                        <GradientStop Offset="1" Color="#33000000" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ====================================================
             HERO CONTENT — magazine layout
             ==================================================== -->
        <Grid Padding="64,40,64,140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Left: layered album art -->
            <Grid Grid.Column="0" MaxWidth="540" MaxHeight="540" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                <!-- Soft shadow plate (offset darkened rect — Mica-friendly) -->
                <Border CornerRadius="20" Width="500" Height="500"
                        Background="#22000000"
                        Margin="0,18,0,-18" />

                <controls:AlbumArtwork
                    Width="500" Height="500"
                    FromColor="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexColor}, Mode=OneWay}"
                    ToColor="{Binding CurrentTrack.ArtGradientToHex,   Converter={StaticResource HexColor}, Mode=OneWay}"
                    TitleText="{Binding CurrentTrack.Album, Mode=OneWay}"
                    ArtistText="{Binding CurrentTrack.Artist, Mode=OneWay}"
                    YearText="{Binding CurrentTrack.Year, Mode=OneWay}" />
            </Grid>

            <!-- Right: title + transport (editorial) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="14" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,40,0,0">

                    <!-- Eyebrow -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Rectangle Width="32" Height="2" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="NOW PLAYING"
                                   FontFamily="{ThemeResource ResonanceMonoFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="300"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Hero title — display serif, big -->
                    <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}"
                               FontFamily="{ThemeResource ResonanceDisplayFont}"
                               FontSize="80"
                               FontWeight="Bold"
                               LineHeight="84"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />

                    <!-- Artist — line + name layout -->
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}"
                                   FontFamily="{ThemeResource ResonanceDisplayFont}"
                                   FontStyle="Italic"
                                   FontSize="22"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Rectangle Width="40" Height="1" Fill="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentTrack.Album, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Scrubber -->
                    <StackPanel Spacing="4" Margin="0,28,0,0">
                        <Slider Minimum="0"
                                Maximum="{Binding CurrentTrack.DurationSeconds, Mode=OneWay}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}" />
                        <Grid>
                            <TextBlock Text="{Binding PositionSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                       FontFamily="{ThemeResource ResonanceMonoFont}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding CurrentTrack.DurationSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                       FontFamily="{ThemeResource ResonanceMonoFont}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Transport — branded chrome -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Click="Shuffle_Click" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22">
                            <FontIcon Glyph="&#xE8B1;" FontSize="16" />
                        </Button>
                        <Button Click="Previous_Click" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22">
                            <FontIcon Glyph="&#xE892;" FontSize="16" />
                        </Button>

                        <!-- Big play button — branded with brand accent + ring -->
                        <Grid Width="72" Height="72" Margin="6,0">
                            <Ellipse Width="72" Height="72"
                                     Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                     StrokeThickness="1"
                                     Opacity="0.4" />
                            <Button Click="PlayPause_Click" Style="{ThemeResource AccentButtonStyle}"
                                    Width="64" Height="64" CornerRadius="32"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}, Mode=OneWay}" FontSize="22" />
                            </Button>
                        </Grid>

                        <Button Click="Next_Click" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22">
                            <FontIcon Glyph="&#xE893;" FontSize="16" />
                        </Button>
                        <Button Click="Repeat_Click" Style="{ThemeResource SubtleButtonStyle}" Width="44" Height="44" CornerRadius="22">
                            <FontIcon Glyph="&#xE8EE;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!-- Volume + actions row -->
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE993;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Slider Width="180" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{Binding Volume, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Style="{ThemeResource SubtleButtonStyle}" Width="40" Height="40" CornerRadius="20" ToolTipService.ToolTip="Like">
                                <FontIcon Glyph="&#xEB52;" FontSize="14" />
                            </Button>
                            <Button Style="{ThemeResource SubtleButtonStyle}" Width="40" Height="40" CornerRadius="20" ToolTipService.ToolTip="Add to playlist">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Style="{ThemeResource SubtleButtonStyle}" Width="40" Height="40" CornerRadius="20" ToolTipService.ToolTip="Share">
                                <FontIcon Glyph="&#xE72D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
