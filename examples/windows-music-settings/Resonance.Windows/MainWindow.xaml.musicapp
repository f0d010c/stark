<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Resonance.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resonance"
    xmlns:views="using:Resonance.Views">

    <!-- Mica backdrop is set in code-behind via SystemBackdrop = new MicaBackdrop()  -->

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <local:SecondsToTimeConverter  x:Key="Time" />
            <local:HexToBrushConverter     x:Key="HexBrush" />
            <local:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />
        </Grid.Resources>

        <!-- Title bar (extended into client area; preserves Snap Layouts hover) -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="48"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xE8D6;"
                      FontSize="14"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TitleBarTitle"
                       Grid.Column="1"
                       Text="Resonance"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}" />
        </Grid>

        <!-- Main NavigationView shell -->
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged"
                        Loaded="Nav_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Now Playing" Tag="now">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Browse" Tag="browse">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Radio" Tag="radio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="Playlists" />
                <NavigationViewItem Content="Recently Added" Tag="recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Made for You" Tag="madefor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Persistent playback bar (Acrylic transient surface — proper Fluent idiom) -->
        <Grid Grid.Row="2"
              Height="84"
              x:Name="PlaybackBar"
              DataContext="{x:Bind Playback, Mode=OneWay}">
            <Grid.Background>
                <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBaseAlt}"
                              TintOpacity="0.65"
                              FallbackColor="{ThemeResource SolidBackgroundFillColorBase}" />
            </Grid.Background>

            <Border BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid Padding="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Now playing chip (left) -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border CornerRadius="6" Width="48" Height="48">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexBrush}, Mode=OneWay}" />
                                    <GradientStop Offset="1" Color="{Binding CurrentTrack.ArtGradientToHex,   Converter={StaticResource HexBrush}, Mode=OneWay}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="{Binding CurrentTrack.ArtGlyph, Mode=OneWay}"
                                      FontSize="18"
                                      Foreground="#33FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxWidth="240"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: transport + scrubber -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="520">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button Click="MiniShuffle_Click" Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" CornerRadius="18">
                                <FontIcon Glyph="&#xE8B1;" FontSize="13" />
                            </Button>
                            <Button Click="MiniPrev_Click" Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" CornerRadius="18">
                                <FontIcon Glyph="&#xE892;" FontSize="13" />
                            </Button>
                            <Button Click="MiniPlay_Click" Style="{ThemeResource AccentButtonStyle}" Width="40" Height="40" CornerRadius="20">
                                <FontIcon Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}, Mode=OneWay}" FontSize="14" />
                            </Button>
                            <Button Click="MiniNext_Click" Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" CornerRadius="18">
                                <FontIcon Glyph="&#xE893;" FontSize="13" />
                            </Button>
                            <Button Click="MiniRepeat_Click" Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" CornerRadius="18">
                                <FontIcon Glyph="&#xE8EE;" FontSize="13" />
                            </Button>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PositionSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                       FontFamily="Cascadia Mono" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Margin="0,0,8,0" />
                            <Slider Grid.Column="1"
                                    Minimum="0"
                                    Maximum="{Binding CurrentTrack.DurationSeconds, Mode=OneWay}"
                                    Value="{Binding PositionSeconds, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentTrack.DurationSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                       FontFamily="Cascadia Mono" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: queue + volume -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{ThemeResource SubtleButtonStyle}" Width="36" Height="36" CornerRadius="18"
                                ToolTipService.ToolTip="Queue">
                            <FontIcon Glyph="&#xE8FD;" FontSize="13" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop />
                                    </Flyout.SystemBackdrop>
                                    <StackPanel Width="320" Spacing="6">
                                        <TextBlock Text="Queue" FontSize="14" FontWeight="SemiBold" />
                                        <ItemsRepeater ItemsSource="{x:Bind Playback.Queue, Mode=OneWay}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate xmlns:m="using:Resonance.Models">
                                                    <Grid Padding="6,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border CornerRadius="3" Width="22" Height="22" VerticalAlignment="Center">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Offset="0" Color="{Binding ArtGradientFromHex, Converter={StaticResource HexBrush}}" />
                                                                    <GradientStop Offset="1" Color="{Binding ArtGradientToHex,   Converter={StaticResource HexBrush}}" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" />
                                                            <TextBlock Text="{Binding Artist}" FontSize="10"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding DurationSeconds, Converter={StaticResource Time}}"
                                                                   FontFamily="Cascadia Mono" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <FontIcon Glyph="&#xE993;" FontSize="13"
                                  Margin="6,0,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" />
                        <Slider Width="100"
                                Minimum="0" Maximum="1" StepFrequency="0.01"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
