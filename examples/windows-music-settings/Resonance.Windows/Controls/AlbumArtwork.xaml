<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonance.Controls.AlbumArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resonance">

    <UserControl.Resources>
        <local:HexToColorConverter x:Key="HexColor" />
    </UserControl.Resources>

    <Grid x:Name="Root">
        <!-- Base gradient -->
        <Border CornerRadius="20" x:Name="BaseLayer">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0"   Color="{x:Bind FromColor, Mode=OneWay}" />
                    <GradientStop Offset="1"   Color="{x:Bind ToColor, Mode=OneWay}" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Big circle (vinyl record / planet abstraction) -->
        <Ellipse x:Name="OrbCircle"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-20,-40,0"
                 Width="280" Height="280"
                 Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.4,0.4" GradientOrigin="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Offset="0" Color="White" />
                    <GradientStop Offset="0.6" Color="{x:Bind FromColor, Mode=OneWay}" />
                    <GradientStop Offset="1" Color="{x:Bind ToColor, Mode=OneWay}" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Smaller orbital circle -->
        <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,40,40,0"
                 Width="100" Height="100" Opacity="0.4">
            <Ellipse.Stroke>
                <SolidColorBrush Color="White" Opacity="0.6" />
            </Ellipse.Stroke>
            <Ellipse.StrokeThickness>1</Ellipse.StrokeThickness>
        </Ellipse>

        <!-- Diagonal stripe accent -->
        <Rectangle x:Name="DiagonalStripe"
                   HorizontalAlignment="Stretch"
                   Height="180"
                   VerticalAlignment="Center"
                   Margin="-40,0,-40,0"
                   Opacity="0.20">
            <Rectangle.Fill>
                <SolidColorBrush Color="White" />
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="-12" />
            </Rectangle.RenderTransform>
            <Rectangle.RenderTransformOrigin>0.5,0.5</Rectangle.RenderTransformOrigin>
        </Rectangle>

        <!-- Top highlight -->
        <Border CornerRadius="20" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#33FFFFFF" />
                    <GradientStop Offset="0.5" Color="Transparent" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Bottom darken for legibility -->
        <Border CornerRadius="20" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="0,1">
                    <GradientStop Offset="0" Color="Transparent" />
                    <GradientStop Offset="1" Color="#66000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Wordmark — title + artist on cover (designed feel) -->
        <Grid Padding="28" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="2">
                <Rectangle Width="22" Height="2" Fill="White" Opacity="0.85" Margin="0,0,0,4" />
                <TextBlock Text="{x:Bind YearText, Mode=OneWay}"
                           FontFamily="{ThemeResource ResonanceMonoFont}"
                           FontSize="10"
                           CharacterSpacing="200"
                           Foreground="White"
                           Opacity="0.85" />
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Spacing="0">
                <TextBlock Text="{x:Bind TitleText, Mode=OneWay}"
                           FontFamily="{ThemeResource ResonanceDisplayFontBold}"
                           FontSize="36"
                           LineHeight="38"
                           Foreground="White"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ArtistText, Mode=OneWay}"
                           FontFamily="{ThemeResource ResonanceDisplayFontRegular}"
                           FontStyle="Italic"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="White"
                           Opacity="0.92" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
