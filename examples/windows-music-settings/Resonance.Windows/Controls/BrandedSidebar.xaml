<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Resonance.Controls.BrandedSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="240" Background="Transparent">
        <Border BorderThickness="0,0,1,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Spacing="22" Padding="20,28,20,28">

                    <!-- Section: navigation -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="LIBRARY"
                                   FontFamily="{ThemeResource ResonanceMonoFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="300"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="6,0,0,8" />
                        <Button x:Name="NavNow"
                                Click="Nav_Click"
                                Tag="now"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE93C;" FontSize="14" />
                                <TextBlock Text="Now Playing" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLib"
                                Click="Nav_Click"
                                Tag="library"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Albums" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavBrowse"
                                Click="Nav_Click"
                                Tag="browse"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Browse" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavRadio"
                                Click="Nav_Click"
                                Tag="radio"
                                Style="{StaticResource SidebarItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9F4;" FontSize="14" />
                                <TextBlock Text="Radio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Section: playlists (editorial vibe) -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="PLAYLISTS"
                                   FontFamily="{ThemeResource ResonanceMonoFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="300"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Margin="6,0,0,8" />
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Width="3" Height="14" Fill="{ThemeResource SystemAccentColorLight2}" />
                                <TextBlock Text="Late Nights" FontFamily="{ThemeResource ResonanceDisplayFontRegular}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="madefor" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Width="3" Height="14" Fill="#7C3AED" />
                                <TextBlock Text="Saturn Evenings" FontFamily="{ThemeResource ResonanceDisplayFontRegular}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Width="3" Height="14" Fill="#FACC15" />
                                <TextBlock Text="Long Drives" FontFamily="{ThemeResource ResonanceDisplayFontRegular}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Width="3" Height="14" Fill="#10B981" />
                                <TextBlock Text="Coffee &amp; Code" FontFamily="{ThemeResource ResonanceDisplayFontRegular}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle Width="3" Height="14" Fill="#EC4899" />
                                <TextBlock Text="Heat Waves" FontFamily="{ThemeResource ResonanceDisplayFontRegular}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Section: settings (footer-ish) -->
                    <StackPanel Spacing="2" Margin="0,8,0,0">
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="6,0,6,12" />
                        <Button Style="{StaticResource SidebarItemStyle}" Tag="settings" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
