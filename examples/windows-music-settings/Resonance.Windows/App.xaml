<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Resonance.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/SidebarStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============================================
                 BRAND OVERRIDES — Resonance identity
                 ============================================
                 Brand accent: deep red (warm, distinct from system blue)
                 Display font: Newsreader (neo-serif, editorial restraint)
                 Body font: Segoe UI Variable (kept for system surfaces) -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#C53030</Color>
                    <Color x:Key="SystemAccentColorLight1">#E53E3E</Color>
                    <Color x:Key="SystemAccentColorLight2">#FC8181</Color>
                    <Color x:Key="SystemAccentColorLight3">#FED7D7</Color>
                    <Color x:Key="SystemAccentColorDark1">#9B2C2C</Color>
                    <Color x:Key="SystemAccentColorDark2">#742A2A</Color>
                    <Color x:Key="SystemAccentColorDark3">#5D2020</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="SystemAccentColor">#FC8181</Color>
                    <Color x:Key="SystemAccentColorLight1">#FEB2B2</Color>
                    <Color x:Key="SystemAccentColorLight2">#FED7D7</Color>
                    <Color x:Key="SystemAccentColorLight3">#FFF5F5</Color>
                    <Color x:Key="SystemAccentColorDark1">#E53E3E</Color>
                    <Color x:Key="SystemAccentColorDark2">#C53030</Color>
                    <Color x:Key="SystemAccentColorDark3">#9B2C2C</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Display font — used ONLY for hero content (page titles, NowPlaying hero).
                 Segoe UI Variable stays for system surfaces. -->
            <FontFamily x:Key="ResonanceDisplayFont">ms-appx:///Assets/Fonts/Newsreader-700.ttf#Newsreader</FontFamily>
            <FontFamily x:Key="ResonanceDisplayFontRegular">ms-appx:///Assets/Fonts/Newsreader-400.ttf#Newsreader</FontFamily>
            <FontFamily x:Key="ResonanceDisplayFontBold">ms-appx:///Assets/Fonts/Newsreader-800.ttf#Newsreader</FontFamily>
            <FontFamily x:Key="ResonanceMonoFont">Cascadia Mono</FontFamily>

            <!-- Custom NavigationView corner radius (10 vs default 4) -->
            <CornerRadius x:Key="NavigationViewItemCornerRadius">10</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
