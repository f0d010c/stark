<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Resonance.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Resonance"
    xmlns:controls="using:Resonance.Controls"
    xmlns:views="using:Resonance.Views">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <local:SecondsToTimeConverter  x:Key="Time" />
            <local:HexToBrushConverter     x:Key="HexBrush" />
            <local:HexToColorConverter     x:Key="HexColor" />
            <local:PlayPauseGlyphConverter x:Key="PlayPauseGlyph" />
        </Grid.Resources>

        <!-- Title bar (extended; Snap Layouts preserved) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="3" Height="14" Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Resonance"
                           FontFamily="{ThemeResource ResonanceDisplayFont}"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock Text="·"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Text="MUSIC FOR LISTENING"
                           FontFamily="{ThemeResource ResonanceMonoFont}"
                           FontSize="9"
                           CharacterSpacing="300"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Body: custom sidebar + content frame -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:BrandedSidebar x:Name="Sidebar" Grid.Column="0" NavRequested="Sidebar_NavRequested" />

            <Frame x:Name="ContentFrame" Grid.Column="1" />
        </Grid>

        <!-- Custom playback bar — branded chrome (gradient from track + transport) -->
        <Grid Grid.Row="2"
              Height="92"
              x:Name="PlaybackBar"
              DataContext="{x:Bind Playback, Mode=OneWay}">

            <!-- Background: art-tinted gradient (subtle), then base color overlay -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0"   Color="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexColor}, Mode=OneWay}" />
                        <GradientStop Offset="1"   Color="{Binding CurrentTrack.ArtGradientToHex,   Converter={StaticResource HexColor}, Mode=OneWay}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Dark overlay for legibility -->
            <Border>
                <Border.Background>
                    <SolidColorBrush Color="Black" Opacity="0.55" />
                </Border.Background>
            </Border>
            <!-- Top hairline -->
            <Border BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" />

            <!-- Content -->
            <Grid Padding="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Now playing chip -->
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border CornerRadius="6" Width="56" Height="56">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{Binding CurrentTrack.ArtGradientFromHex, Converter={StaticResource HexColor}, Mode=OneWay}" />
                                <GradientStop Offset="1" Color="{Binding CurrentTrack.ArtGradientToHex,   Converter={StaticResource HexColor}, Mode=OneWay}" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTrack.Title, Mode=OneWay}"
                                   FontFamily="{ThemeResource ResonanceDisplayFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   MaxWidth="280"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentTrack.Artist, Mode=OneWay}"
                                   FontFamily="{ThemeResource ResonanceDisplayFontRegular}"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.78"
                                   MaxWidth="280"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: transport + scrubber -->
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="540">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Click="MiniShuffle_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8B1;" FontSize="13" Foreground="White" />
                        </Button>
                        <Button Click="MiniPrev_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE892;" FontSize="13" Foreground="White" />
                        </Button>
                        <Button Click="MiniPlay_Click" Width="44" Height="44" CornerRadius="22"
                                Background="White" BorderThickness="0">
                            <FontIcon Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseGlyph}, Mode=OneWay}"
                                      FontSize="14" Foreground="Black" />
                        </Button>
                        <Button Click="MiniNext_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE893;" FontSize="13" Foreground="White" />
                        </Button>
                        <Button Click="MiniRepeat_Click" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE8EE;" FontSize="13" Foreground="White" />
                        </Button>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding PositionSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                   FontFamily="{ThemeResource ResonanceMonoFont}" FontSize="11"
                                   Foreground="White" Opacity="0.78"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Margin="0,0,8,0" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="{Binding CurrentTrack.DurationSeconds, Mode=OneWay}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentTrack.DurationSeconds, Converter={StaticResource Time}, Mode=OneWay}"
                                   FontFamily="{ThemeResource ResonanceMonoFont}" FontSize="11"
                                   Foreground="White" Opacity="0.78"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Right: queue + volume -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0">
                        <FontIcon Glyph="&#xE8FD;" FontSize="13" Foreground="White" />
                    </Button>
                    <FontIcon Glyph="&#xE993;" FontSize="13" Foreground="White" Opacity="0.78" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Slider Width="100" Minimum="0" Maximum="1" StepFrequency="0.01"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
